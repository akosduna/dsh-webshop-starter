# Kopiraj ovu datoteku u .env.local i upiši svoje vrijednosti.
# .env.local se NIKAD ne commita (već je u .gitignore).

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Publishable key (sb_publishable_...) ili stari "anon" ključ
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Secret key (sb_secret_...) ili stari "service_role" ključ — SAMO na serveru, nikad u browseru
SUPABASE_SECRET_KEY=sb_secret_REPLACE_ME

# --- Adresa trgovine (bez kose crte na kraju) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Stripe (Dashboard → Developers → API keys), test mode ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Lokalno: ispis naredbe `stripe listen`; produkcija: Stripe Dashboard → Webhooks → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME
