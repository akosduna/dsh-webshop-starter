# Predložak varijabli okruženja. Samo zamjenske vrijednosti — prave ključeve
# upiši u .env.local (ne commita se) i u Vercel → Settings → Environment Variables.
#
# Vrijednost REPLACE_ME (ili prazna) znači „nije postavljeno”: modul koji je
# treba ostaje isključen, a Admin → Pregled pokazuje koji ključ nedostaje.
# Modulima se upravlja u src/config/modules.ts.

# --- Adresa trgovine (bez kose crte na kraju) ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Baza (Neon Postgres) — `vercel env pull .env.local` ih upiše sam ---
# Pooled URL (aplikacija i prijava)
DATABASE_URL=postgresql://user:REPLACE_ME@ep-example-pooler.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Direktni URL (migracije). Ako ga nema, koristi se DATABASE_URL.
DATABASE_URL_UNPOOLED=postgresql://user:REPLACE_ME@ep-example.eu-central-1.aws.neon.tech/neondb?sslmode=require
# Samo ako izravna TCP veza ne radi: Neon serverless (WebSocket) driver
# USE_NEON_SERVERLESS_POOL=true
# USE_NEON_SERVERLESS_AUTH_POOL=true

# --- Prijava (Better Auth) ---
# Nasumičan niz od barem 32 znaka: `openssl rand -base64 32`
BETTER_AUTH_SECRET=REPLACE_ME
# E-mailovi koji nakon registracije automatski postaju administratori (zarezom odvojeni)
ADMIN_EMAILS=vlasnik@example.com
# Dodatne domene s kojih je dopuštena prijava (zarezom odvojene, s https://)
# ADDITIONAL_TRUSTED_ORIGINS=https://www.moja-trgovina.hr

# --- Slike (Vercel Blob) — Vercel → Storage → Blob, `vercel env pull` ga upiše ---
BLOB_READ_WRITE_TOKEN=REPLACE_ME

# --- Uplata na račun (virman, HUB-3 barkod) ---
# Primjer formata IBAN-a: HR1210010051863000160
BANK_IBAN=REPLACE_ME
BANK_RECIPIENT_NAME=REPLACE_ME
BANK_RECIPIENT_STREET=REPLACE_ME
# Poštanski broj i mjesto, npr. 10000 Zagreb
BANK_RECIPIENT_CITY=REPLACE_ME
BANK_PAYMENT_MODEL=HR00
# Poziv na broj: {year} = godina narudžbe, {orderNumber} = broj narudžbe
BANK_REFERENCE_TEMPLATE=0-{year}-{orderNumber}
# Koliko dana neplaćena narudžba drži zalihu (nakon toga je admin može skupno otkazati)
BANK_TRANSFER_RESERVATION_DAYS=7

# --- Stripe (Dashboard → Developers → API keys), test način ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_REPLACE_ME
STRIPE_SECRET_KEY=sk_test_REPLACE_ME
# Lokalno: ispis `stripe listen`; produkcija: Webhooks → endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_REPLACE_ME

# --- Teya SecurePay (modul je isključen dok ga ne uključiš u src/config/modules.ts) ---
TEYA_MERCHANT_ID=REPLACE_ME
TEYA_PAYMENT_GATEWAY_ID=REPLACE_ME
TEYA_SECRET_KEY=REPLACE_ME
# Test: https://test.borgun.is/SecurePay/default.aspx — produkcijski URL daje Teya
TEYA_API_URL=REPLACE_ME
TEYA_CURRENCY=EUR
TEYA_LANGUAGE=HR
# Dva slova ispred broja narudžbe u Teya OrderId
TEYA_ORDER_PREFIX=WS

# --- GLS (MyGLS API) ---
GLS_USERNAME=REPLACE_ME
GLS_PASSWORD=REPLACE_ME
GLS_CLIENT_NUMBER=REPLACE_ME
# test | production
GLS_MODE=test
GLS_SENDER_NAME=REPLACE_ME
GLS_SENDER_STREET=REPLACE_ME
GLS_SENDER_HOUSE_NUMBER=
GLS_SENDER_CITY=REPLACE_ME
GLS_SENDER_ZIP=REPLACE_ME
GLS_SENDER_COUNTRY=HR
GLS_SENDER_CONTACT_NAME=
GLS_SENDER_PHONE=
GLS_SENDER_EMAIL=
# Format naljepnice: A4_2x2 | A4_4x1 | Connect | Thermo
GLS_PRINTER_TYPE=A4_2x2

# --- BOX NOW ---
BOXNOW_CLIENT_ID=REPLACE_ME
BOXNOW_CLIENT_SECRET=REPLACE_ME
BOXNOW_PARTNER_ID=REPLACE_ME
# ID skladišta / mjesta preuzimanja koje ti dodijeli BOX NOW
BOXNOW_WAREHOUSE_ID=REPLACE_ME
BOXNOW_WEBHOOK_SECRET=REPLACE_ME
# Sandbox URL koji daje BOX NOW za testiranje (prazno = produkcija)
BOXNOW_API_URL=
# Veličina pretinca: 1 = mali, 2 = srednji, 3 = veliki
BOXNOW_COMPARTMENT_SIZE=2
# Kontakt pošiljatelja (prazno = iz Admin → Postavke)
BOXNOW_CONTACT_PHONE=
BOXNOW_CONTACT_EMAIL=

# Prefiks broja narudžbe u referenci pošiljke (GLS / BOX NOW)
ORDER_REFERENCE_PREFIX=WEB

# --- E-mailovi o narudžbi (Resend; modul je isključen dok ga ne uključiš) ---
RESEND_API_KEY=REPLACE_ME
# Npr. Moja trgovina <narudzbe@moja-trgovina.hr> — domena mora biti potvrđena u Resendu
EMAIL_FROM=REPLACE_ME
EMAIL_REPLY_TO=

# --- Zaštita od stvarnih akcija izvan produkcije ---
# Pošiljke (GLS produkcija, BOX NOW) i e-mailovi rade samo na Vercel produkciji.
# ALLOW_LIVE_SIDE_EFFECTS=true ih dopušta drugdje — nikad na Preview okruženju.
ALLOW_LIVE_SIDE_EFFECTS=false
# Adrese koje i izvan produkcije smiju primati e-mail (zarezom odvojene)
PREVIEW_EMAIL_ALLOWLIST=
